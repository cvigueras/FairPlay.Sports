{
  "mcpServers": {
    "shortcut": {
      "type": "http",
      "url": "https://mcp.shortcut.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,pull_requests"
      }
    }
  }
}
